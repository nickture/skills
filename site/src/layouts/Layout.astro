---
import { ClientRouter } from 'astro:transitions';
import '$styles/app.css';

interface Props {
	title: string;
	description?: string;
}
const { title, description = 'Правила интерфейса и русского текста: каждое с причиной и примером' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ru">
	<head>
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-BYFLZ1T07N"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-BYFLZ1T07N');
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/icons/favicon.png" />
		<link rel="icon" href="/icons/favicon.svg" sizes="any" type="image/svg+xml" />
		<link rel="stylesheet" href={`${base}pagefind/pagefind-component-ui.css`} />
		<script is:inline type="module" src={`${base}pagefind/pagefind-component-ui.js`}></script>
		<ClientRouter />
	</head>
	<body>
		<header transition:persist class="bg-bg/90 sticky top-0 z-10 backdrop-blur">
			<div class="mx-auto flex max-w-screen-lg flex-wrap items-center gap-x-6 gap-y-3 px-5 py-4 sm:px-8">
				<a href="/" class="size-10 shrink-0 overflow-hidden rounded-xl shadow-md" aria-label="nickture.com">
					<img src="/images/nick-large.webp" alt="" class="size-full object-cover" />
				</a>
				<a href={base} class="font-medium">Nickture Skills</a>
				<!-- The search index exists only after `bun run build`, so a dev server has no search. -->
				<div class="ml-auto">
					<pagefind-config bundle-path={`${base}pagefind/`}></pagefind-config>
					<pagefind-modal-trigger></pagefind-modal-trigger>
					<pagefind-modal></pagefind-modal>
				</div>
			</div>
		</header>
		<main class="mx-auto max-w-screen-lg px-5 pt-8 pb-24 sm:px-8">
			<slot />
		</main>
		<footer class="text-secondary px-5 pb-8 text-center text-sm">
			&copy; 1997&hellip;{new Date().getFullYear()} · <a class="link" href="https://github.com/nickture/skills">GitHub</a> · CC BY 4.0
		</footer>
	</body>
</html>
