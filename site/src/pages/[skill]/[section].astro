---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Layout from '$layouts/Layout.astro';

export async function getStaticPaths() {
	return (await getCollection('sections')).map((entry) => ({
		params: { skill: entry.data.skill, section: entry.data.file },
		props: { entry },
	}));
}

const { entry } = Astro.props as { entry: CollectionEntry<'sections'> };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const skill = (await getEntry('skills', entry.data.skill))!;
const siblings = (await getCollection('sections', (s) => s.data.skill === entry.data.skill)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Layout title={`${entry.data.title}: ${skill.data.title.toLowerCase()}`} description={entry.data.summary}>
	<div class="grid gap-12 lg:grid-cols-[13rem_1fr]">
		<nav aria-label={skill.data.title} class="text-sm lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto">
			<a class="link font-medium" href={`${base}#${skill.id}`}>{skill.data.title}</a>
			<ul class="mt-3 hidden flex-col gap-1.5 lg:flex">
				{
					siblings.map((s) => (
						<li>
							<a
								href={`${base}${s.data.skill}/${s.data.file}/`}
								aria-current={s.id === entry.id ? 'page' : undefined}
								class="text-secondary hover:text-primary aria-[current=page]:font-medium aria-[current=page]:text-gray-900"
							>
								{s.data.title}
							</a>
						</li>
					))
				}
				<li class="mt-3"><a class="text-secondary hover:text-primary" href={`${base}${skill.id}/sources/`}>Источники</a></li>
			</ul>
		</nav>
		<article class="rules min-w-0" data-pagefind-body set:html={entry.rendered?.html} />
	</div>
</Layout>
